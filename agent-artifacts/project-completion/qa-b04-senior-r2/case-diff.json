  "fieldDiffs": {
    "TC-117": [
      {
        "field": "/options/1/whenItWouldBeBest",
        "before": "Если бронь не гарантирует нужной мощности, а полный перевод сегодня её гарантирует и его цена ниже ожидаемого ущерба ожидания.",
        "after": "Если предварительная бронь даёт только место для пробной партии, а мощности для перевода остатка в понедельник при таком бронировании нет. Тогда только полный перевод сегодня защищает заказ, и его цена 8 меньше ожидаемых потерь 12–18 без защиты."
      },
      {
        "field": "/revision",
        "before": 1,
        "after": 2
      }
    ],
    "TC-118": [
      {
        "field": "/options/1/whenItWouldBeBest",
        "before": "Если первый слой сам разблокирует все заявленные продажи без следующих слоёв и его показатель выше конкурирующей работы.",
        "after": "Если первый технический слой сам по себе за одну неделю открывает все продажи с маржой 36 в неделю, следующие слои не добавляют дохода и остальные работы можно сразу вернуть в общую очередь. Тогда 36 / 1 превышает 20 / 4, а ждать четыре недели до каталога незачем."
      },
      {
        "field": "/revision",
        "before": 1,
        "after": 2
      }
    ]
  },
